/target
**/target
.tools/
__pycache__/
*.pyc
.venv/
# Heavy-tier bound goldens: regenerated by scripts/gen_la_goldens.py --heavy / gen_matrix_goldens.py --heavy, hashes pinned in HEAVY.SHA256.
# Not committed, except the S6 matrix and LA3 QR heavy tiers (r6 item b, Paul): committed (< 100 MB each), so their tests always run.
zenith-float-bound/tests/goldens/slices/**/*_heavy.txt
!zenith-float-bound/tests/goldens/slices/matrix/matrix_rows_heavy.txt
!zenith-float-bound/tests/goldens/slices/qr/la_qr_enc4096_heavy.txt
# Gen mode's readable copy of the MPFR golden streams (tools/mpfr_golden/gen.sh; read by crosscheck.py), not committed
zenith-float-num/tests/mpfr/golden-full/
